{
  "name": "@uride/admin-web",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "description": "WeRide admin / ops portal. Next.js (App Router).",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "next build",
    "build:standalone": "npm run build:libs && npm run build",
    "dev": "next dev --port 3001",
    "start": "next start --port 3001",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "echo 'admin-web: no tests yet'",
    "clean": "rimraf .next .turbo",
    "build:libs": "npm run build -w packages/types && npm run build -w packages/validation && npm run build -w packages/ui-tokens && npm run build -w packages/api-client"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@tanstack/react-query": "^5.62.7",
    "@uride/api-client": "*",
    "@uride/types": "*",
    "@uride/ui-tokens": "*",
    "@uride/ui-web": "*",
    "@uride/validation": "*",
    "clsx": "^2.1.1",
    "next": "^15.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.0",
    "tailwind-merge": "^2.6.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@uride/config": "*",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.3",
    "postcss": "^8.4.49",
    "rimraf": "^6.0.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  }
}
