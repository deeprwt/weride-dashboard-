{
  "name": "@uride/ui-tokens",
  "version": "0.0.0",
  "private": true,
  "description": "Single source of truth for design tokens — colors, spacing, type, motion. Consumed by web (Tailwind) and mobile (NativeWind).",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./tailwind": {
      "types": "./dist/tailwind.d.ts",
      "import": "./dist/tailwind.mjs",
      "require": "./dist/tailwind.js"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsup src/index.ts src/tailwind.ts --format esm,cjs --dts --clean",
    "dev": "tsup src/index.ts src/tailwind.ts --format esm,cjs --dts --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "echo 'ui-tokens: no tests yet'",
    "clean": "rimraf dist .turbo"
  },
  "devDependencies": {
    "@uride/config": "*",
    "eslint": "^9.17.0",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
