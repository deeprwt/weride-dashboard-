# WeRide admin-web environment.
# Copy to .env.local (gitignored). Next.js exposes only NEXT_PUBLIC_* to the browser.

NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:4000/rt

# Phase 1+
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_MAPBOX_TOKEN=

# Server-only (Phase 1+)
SUPABASE_SERVICE_ROLE_KEY=
SENTRY_DSN=
